---
// The family Ω, from omega-brand/scripts/omega-icon.mjs, drawn flat in currentColor and cropped to the mark.
interface Props { class?: string; title?: string; style?: string }
const { class: cls, title, style } = Astro.props;
const id = `cut-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class={cls} style={style} viewBox="276 290 472 440" role={title ? "img" : undefined} aria-hidden={title ? undefined : "true"} aria-label={title}>
  <clipPath id={id}><path clip-rule="evenodd" d="M0 0 H1024 V724.4 H0 Z M420 535.6 H604 V724.4 H420 Z" /></clipPath>
  <g fill="currentColor">
    <path clip-path={`url(#${id})`} fill-rule="evenodd" d="M276 535.6 a236 236 0 1 0 472 0 a236 236 0 1 0 -472 0 Z M372 535.6 a140 140 0 1 0 280 0 a140 140 0 1 0 -280 0 Z" />
    <rect x="286.4" y="662.4" width="133.6" height="62" />
    <rect x="604" y="662.4" width="133.6" height="62" />
  </g>
</svg>
