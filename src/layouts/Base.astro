---
import "../styles/global.css";
import type { Copy } from "../i18n/en";
interface Props { t: Copy }
const { t } = Astro.props;
---
<!doctype html>
<html lang={t.lang} data-app="zap">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#0d0e0e" />
    <link rel="icon" href="/img/omega-zap.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;600;800&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
